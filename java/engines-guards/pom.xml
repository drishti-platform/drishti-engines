<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.engines</groupId>
    <artifactId>engines-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>engines-guards</artifactId>
  <name>Drishti Engines: the repository's guards (header and file cap, launchers, names no host, no mutable statics, the shape of an engine module)</name>
  <properties>
    <automatic.module.name>com.ash.engines.guards</automatic.module.name>
  </properties>
  <dependencies>
    <!-- the shared guard kit (header and line cap), published by drishti-tools as a test jar -->
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-guards</artifactId><type>test-jar</type><scope>test</scope></dependency>
    <!-- test scope: the statics guard reads the modules' compiled classes with the kit's class-file reader -->
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-tck</artifactId><scope>test</scope></dependency>
    <!-- build order: the guards run after the engines they read -->
    <dependency><groupId>com.ash.engines</groupId><artifactId>engine-capacity</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.ash.engines</groupId><artifactId>engine-genomics-workbench</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.ash.engines</groupId><artifactId>engine-indicators</artifactId><version>${project.version}</version><scope>test</scope></dependency>
  </dependencies>
</project>
