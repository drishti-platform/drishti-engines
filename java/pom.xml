<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ash.engines</groupId>
  <artifactId>engines-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Drishti Engines (reactor)</name>

  <modules>
    <module>engine-capacity</module>
    <module>engine-genomics-workbench</module>
    <module>engine-indicators</module>
    <module>engine-query</module>
    <module>engines-guards</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-11-22T00:00:00Z</project.build.outputTimestamp>
    <!-- the engine API and its kit: released tags (or the 0.1.0-SNAPSHOT of drishti-engine develop) installed in the local repository, never a branch -->
    <engine.api.version>0.1.0-SNAPSHOT</engine.api.version>
    <engine.api.built>0.1</engine.api.built>
    <drishti.tools.version>1.1.0</drishti.tools.version>
    <junit.version>5.12.2</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <engine.test.forks>2</engine.test.forks>
    <argLine></argLine>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>com.ash.engine</groupId><artifactId>engine-api</artifactId><version>${engine.api.version}</version></dependency>
      <dependency><groupId>com.ash.engine</groupId><artifactId>engine-tck</artifactId><version>${engine.api.version}</version></dependency>
      <dependency><groupId>com.ash.engine</groupId><artifactId>engine-cli</artifactId><version>${engine.api.version}</version></dependency>
      <dependency><groupId>com.ash.tools</groupId><artifactId>tools-bom</artifactId><version>${drishti.tools.version}</version><type>pom</type><scope>import</scope></dependency>
      <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version></dependency>
      <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><version>${assertj.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- provided: the host's, shared and parent-first; never inside an engine JAR -->
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-api</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
        <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin>
        <plugin><artifactId>maven-failsafe-plugin</artifactId><version>3.5.2</version></plugin>
        <plugin><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
        <plugin><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
        <plugin><artifactId>maven-install-plugin</artifactId><version>3.1.3</version></plugin>
        <plugin><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version></plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs><arg>-Xlint:all,-serial,-processing,-try</arg></compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
              <Engine-Api>${engine.api.built}</Engine-Api>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>${engine.test.forks}</forkCount>
          <reuseForks>true</reuseForks>
          <!-- the test JVMs' temp folder is the module's target/tmp, never the system /tmp -->
          <tempDir>tmp</tempDir>
          <argLine>@{argLine} -Djava.io.tmpdir=${project.build.directory}/tmp</argLine>
          <systemPropertyVariables>
            <engines.repo.root>${maven.multiModuleProjectDirectory}/..</engines.repo.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                <bannedDependencies>
                  <!-- an engine names no host: no Drishti artifact, no framework, in any scope -->
                  <excludes>
                    <exclude>com.ash.drishti*:*</exclude>
                    <exclude>org.springframework*:*</exclude>
                    <exclude>jakarta.servlet*:*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
