<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.engines</groupId>
    <artifactId>engines-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>engine-query</artifactId>
  <name>Drishti Engines: engine-query</name>
  <description>The query engine (EN-51): pivot views, model queries and derived-kind declarations over tables the request names, read as the caller; grouping pushed to the host through the grouped scan. One JAR; engine-api and tools-xlsx are provided by the host; nothing else. Its kit runs on the packaged JAR in this build.</description>
  <properties>
    <automatic.module.name>com.ash.engines.query</automatic.module.name>
  </properties>
  <dependencies>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-xlsx</artifactId><scope>provided</scope></dependency>
    <!-- the kit and its harness, for this build's own tests only -->
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-tck</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.ash.engine</groupId><artifactId>engine-cli</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <!-- the kit on the packaged JAR, as a host will meet it: after package, before install -->
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
          </execution>
        </executions>
        <configuration>
          <tempDir>tmp</tempDir>
          <argLine>-Djava.io.tmpdir=${project.build.directory}/tmp</argLine>
          <systemPropertyVariables>
            <engine.jar>${project.build.directory}/${project.build.finalName}.jar</engine.jar>
            <engine.cases>${project.basedir}/tck/cases</engine.cases>
            <engine.kit.out>${project.build.directory}/kit</engine.kit.out>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
